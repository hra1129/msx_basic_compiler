100 DEFINT A-Z
110 PRINT "PLAY QUEUE TEST"
120 P=1:A$="T255O4L64"+STRING$(246,67)
130 IF LEN(A$)<>255 THEN PRINT "FAIL MML LENGTH":END
140 PLAY A$:A$=SPACE$(255):A$=""
150 IF PEEK(&HFB3F)<>0 THEN GOTO 150
160 PRINT "PASS LONG MML"
170 P=2:PLAY "T255O4L64"+STRING$(50,67),"T255O3L8CE","T255O5L64"+STRING$(50,71)
180 IF PEEK(&HFB3F)<>0 THEN GOTO 180
190 PRINT "PASS UNEVEN VOICES"
200 P=3:PLAY "T240O1L8V8C","T240O8L8V8B","T240O4L8V8N0"
210 IF PEEK(&HFB3F)<>0 THEN GOTO 210
220 P=4:PLAY "O4L8T240V8C#D-E.F8R8N49."
