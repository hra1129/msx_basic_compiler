100 DEFINT A-Z
110 PRINT "STANDARD PSG PLAY TEST"
120 IF PLAY(0)<>0 OR PLAY(1)<>0 OR PLAY(2)<>0 OR PLAY(3)<>0 THEN GOTO 900
130 P=1:PLAY "T240L8M1000S9CRD"
140 IF PLAY(1)<>-1 OR PLAY(0)<>-1 THEN GOTO 900
150 IF PLAY(0)<>0 THEN GOTO 150
155 IF PLAY(1)<>0 OR PLAY(2)<>0 OR PLAY(3)<>0 THEN GOTO 900
160 P=2:PLAY "S1C M65535S15D V6E M1S0F"
170 IF PLAY(0)<>0 THEN GOTO 170
180 P=3:TP=240:LN=8:VO=5:NN=49:EP!=-1:SH#=10
190 A$="O5C":B$="XA$;D":C$="T=TP;L=LN;V=VO;XB$;E N=NN;"
200 PLAY C$,"T240L8M=EP!;S=SH#;O3CRD","T240L8V7O4G"
210 FOR I=1 TO 3:IF PLAY(I)<>-1 THEN GOTO 900
220 NEXT I
230 IF PLAY(0)<>0 THEN GOTO 230
240 P=4:A$="":PLAY "V8XA$;C":PLAY "D"
250 IF PLAY(0)<>0 THEN GOTO 250
260 P=5:PLAY "M2000":PLAY "S9C"
270 IF PLAY(0)<>0 THEN GOTO 270
280 P=6:DIM AR$(2,3),NT(2,3):AR$(1,2)="O4CD":NT(1,2)=49:J=1
281 PLAY "T240L8V8XAR$(J,1+1);N=NT(J,2);"
282 IF PLAY(0)<>0 THEN GOTO 282
283 P=7:PLAY "MSC"
284 IF PLAY(0)<>0 THEN GOTO 284
285 P=8:A$=STRING$(100,"C"):B$="M900S13"+A$:PLAY "T255L64XB$;"
286 IF PLAY(0)<>0 THEN GOTO 286
287 P=9:PRINT "PASS STANDARD PLAY"
290 END
900 PRINT "FAIL PLAY STATUS":P=-1:END
