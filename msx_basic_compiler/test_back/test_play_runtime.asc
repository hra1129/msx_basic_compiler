100 DEFINT A-Z
110 PRINT "PLAY BIOS TEST"
120 P=1:PLAY "CDEFG":PRINT "QUEUED BASIC"
130 IF PEEK(&HFB3F)<>0 THEN GOTO 130
140 PRINT "PASS BASIC"
150 P=2:A$="t240 o3 l8 v6 c# d- e. f8 r8 n49.":PLAY A$:A$=SPACE$(255):A$=""
160 IF PEEK(&HFB3F)<>0 THEN GOTO 160
170 PRINT "PASS VARIABLE"
180 P=3:PLAY "T240O4L8V5CEG","T240O3L8V6DF","T240O5L8V7GB"
190 IF PEEK(&HFB3F)<>0 THEN GOTO 190
200 PRINT "PASS THREE VOICES"
210 P=4:PLAY ,,"T240O4L8V9C"
220 IF PEEK(&HFB3F)<>0 THEN GOTO 220
230 PRINT "PASS OMITTED"
240 P=5:PLAY "T240O4L8V8C":PLAY "D"
250 IF PEEK(&HFB3F)<>0 THEN GOTO 250
260 PRINT "PASS CONSECUTIVE"
270 P=6:PLAY "":PLAY "T240L8N0R8O1CO8BO4C..D16"
280 IF PEEK(&HFB3F)<>0 THEN GOTO 280
290 P=7:PRINT "PASS PLAY ABI"
