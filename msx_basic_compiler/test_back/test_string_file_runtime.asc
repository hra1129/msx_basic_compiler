100 DEFINT A-Z
110 N$="ABIUSE.TXT":OPEN N$ FOR OUTPUT AS #1
120 PRINT #1,USING "<@>";"ABC"
130 PRINT #1,USING "<!>";"ABC"
140 PRINT #1,USING "<& &>";"A"
150 PRINT #1,USING "<& &>";"ABCDE"
151 PRINT #1,USING "<!>";""
152 PRINT #1,USING "<@>";""
160 PRINT #1,"FIRST,SECOND"
170 PRINT #1,CHR$(34);"A,B";CHR$(34);",SECOND"
175 N=123:PRINT #1,N;N+1;123
180 CLOSE #1:OPEN N$ FOR INPUT AS #1:CLOSE #1:PRINT "PASS FILE OUTPUT"
190 N$="ABIRND.DAT":OPEN N$ AS #1 LEN=15
200 FIELD #1,10 AS A$,5 AS B$
210 IF LEN(A$)<>10 THEN PRINT "FAIL FIELD A":END
220 IF LEN(B$)<>5 THEN PRINT "FAIL FIELD B":END
230 LSET A$="1234567890":RSET B$="ABCDE":PUT #1,1
240 LSET A$="XYZ":RSET B$="Q":PUT #1,2
250 GET #1,1
260 IF A$<>"1234567890" THEN PRINT "FAIL GET1 A":END
270 IF B$<>"ABCDE" THEN PRINT "FAIL GET1 B":END
280 C$=A$:FOR I=1 TO 20:D$=SPACE$(20):D$="X":NEXT I
290 GET #1,2
300 IF A$<>"XYZ       " THEN PRINT "FAIL GET2 A":END
310 IF B$<>"    Q" THEN PRINT "FAIL GET2 B":END
320 IF C$<>"1234567890" THEN PRINT "FAIL FIELD COPY":END
330 CLOSE
340 PRINT "PASS FIELD GET PUT"
350 PRINT "PASS STRING FILE ABI"
