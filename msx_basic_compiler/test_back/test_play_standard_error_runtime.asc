100 DEFINT A-Z
110 INPUT "CASE";K
120 IF K=1 THEN P=PLAY(-1)
130 IF K=2 THEN P=PLAY(4)
140 IF K=3 THEN PLAY "M0C"
150 IF K=4 THEN PLAY "M65536C"
160 IF K=5 THEN PLAY "S16C"
170 IF K=6 THEN PLAY "S-1C"
180 IF K=7 THEN A$="8":PLAY "V=A$;C"
190 IF K=8 THEN A=1:PLAY "XA;"
200 IF K=9 THEN A$="C":PLAY "XA$"
210 IF K=10 THEN A$="XA$;":PLAY "XA$;"
220 IF K=11 THEN DIM A$(1):A$(1)="C":PLAY "XA$(2);"
230 IF K=12 THEN A!=40000:PLAY "T=A!;C"
240 IF K=13 THEN A$=CHR$(0):PLAY "XA$;"
250 IF K=14 THEN PLAY "T=ZZ;C"
251 IF K=15 THEN DIM A$(1):A$(1)="C":B$=STRING$(80,"(")+"1"+STRING$(80,")"):PLAY "XA$("+B$+");"
260 PRINT "FAIL: INVALID PLAY ACCEPTED"
