100 DEFINT A-Z
110 A$=INPUT$(0):IF A$<>"" THEN PRINT "FAIL INPUT0":END
120 PRINT "TYPE Z":A$=INPUT$(1)
130 IF A$<>"Z" THEN PRINT "FAIL INPUT1":END
140 PRINT "TYPE ABCDE":A$=INPUT$(5)
150 IF A$<>"ABCDE" THEN PRINT "FAIL INPUT5":END
160 PRINT "PASS INPUT$"
170 A$="ABC":B$=A$:A$="X"
180 IF B$<>"ABC" THEN PRINT "FAIL COPY":END
185 PRINT "PASS COPY"
190 A$=A$:IF A$<>"X" THEN PRINT "FAIL SELF":END
195 PRINT "PASS SELF"
200 A$=A$+B$:IF A$<>"XABC" THEN PRINT "FAIL CONCAT":END
205 PRINT "PASS CONCAT"
210 IF LEN(A$)<>4 THEN PRINT "FAIL LEN":END
220 IF LEFT$(A$,2)<>"XA" THEN PRINT "FAIL LEFT":END
230 IF RIGHT$(A$,2)<>"BC" THEN PRINT "FAIL RIGHT":END
240 IF MID$(A$,2,2)<>"AB" THEN PRINT "FAIL MID":END
250 IF INSTR(A$,"AB")<>2 THEN PRINT "FAIL INSTR":END
260 N=65:IF ASC(CHR$(N))<>65 THEN PRINT "FAIL CHR":END
270 IF STRING$(3,65)<>"AAA" THEN PRINT "FAIL STRING":END
280 IF SPACE$(3)<>"   " THEN PRINT "FAIL SPACE":END
285 PRINT "PASS FUNCTIONS"
290 DIM C$(3)
295 PRINT "PASS DIM"
300 C$(0)="ZERO":C$(1)=A$:C$(2)="":C$(3)="Q"
305 PRINT "PASS ARRAY ASSIGN"
310 FOR I=1 TO 100:A$=SPACE$(20):A$="X":NEXT I
315 PRINT "PASS ALLOC LOOP"
320 IF C$(0)<>"ZERO" THEN PRINT "FAIL ARRAY0":END
330 IF C$(1)<>"XABC" THEN PRINT "FAIL ARRAY1":END
340 IF C$(2)<>"" THEN PRINT "FAIL ARRAY2":END
350 IF C$(3)<>"Q" THEN PRINT "FAIL ARRAY3":END
355 PRINT "PASS ARRAY"
360 READ A$,B$:IF A$<>"DATA" THEN PRINT "FAIL READ1":END
370 IF B$<>"" THEN PRINT "FAIL READ2":END
375 PRINT "PASS READ"
380 A$="123456":LSET A$="AB"
390 IF A$<>"AB    " THEN PRINT "FAIL LSET":END
400 RSET A$="CD":IF A$<>"    CD" THEN PRINT "FAIL RSET":END
410 MID$(A$,2,2)="XY":IF A$<>" XY CD" THEN PRINT "FAIL MIDLET":END
411 LSET A$="123456789":IF A$<>"123456" THEN PRINT "FAIL LSET LONG":END
412 RSET A$="ABCDEF":IF A$<>"ABCDEF" THEN PRINT "FAIL RSET EQUAL":END
413 RSET A$="123456789":IF A$<>"123456" THEN PRINT "FAIL RSET LONG":END
414 LSET A$="":IF A$<>SPACE$(6) THEN PRINT "FAIL LSET EMPTY":END
415 PRINT "PASS SET":DIM D$(1,1):D$(0,0)="A":D$(1,1)="Z":PRINT "PASS DIM2D":ERASE C$
416 PRINT "PASS ERASE C":FOR I=1 TO 10:A$=SPACE$(20):A$="X":NEXT I
417 IF D$(0,0)<>"A" THEN PRINT "FAIL ARRAY2D0":END
418 IF D$(1,1)<>"Z" THEN PRINT "FAIL ARRAY2D1":END
419 ERASE D$:IF A$<>"X" THEN PRINT "FAIL ERASE":END
420 N=123:A$=STR$(N):IF VAL(A$)<>123 THEN PRINT "FAIL STR VAL":END
421 N=255:IF HEX$(N)<>"FF" THEN PRINT "FAIL HEX":END
422 IF OCT$(N)<>"377" THEN PRINT "FAIL OCT":END
423 A$=MKI$(N):IF CVI(A$)<>N THEN PRINT "FAIL MKI CVI":END
424 A$=STRING$(N,65):B$=STRING$(N,66):SWAP A$,B$
425 IF A$<>STRING$(N,66) THEN PRINT "FAIL SWAP A":END
426 IF B$<>STRING$(N,65) THEN PRINT "FAIL SWAP B":END
427 IF LEN(A$)<>255 THEN PRINT "FAIL LEN255":END
428 IF LEFT$(A$,0)<>"" THEN PRINT "FAIL LEFT0":END
429 IF RIGHT$(A$,0)<>"" THEN PRINT "FAIL RIGHT0":END
431 PRINT "PASS STRING ABI"
440 DATA "DATA",""
